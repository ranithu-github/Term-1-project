# Copy to .env.local for local development, and set the same variables in Vercel.
# Never commit real values.

# Supabase (Project Settings -> API Keys). Use the secret key (sb_secret_...); server-only.
# For local development use a SEPARATE dev project, never production.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs session cookies and signup tokens. At least 32 random characters:
#   openssl rand -hex 32
AUTH_SECRET=

# Comma-separated index numbers that get the hardware testing console
DEV_INDEXES=DEV001

# Comma-separated index numbers that can open the admin panel (/admin)
ADMIN_INDEXES=ADMIN-ASTRIX

# MQTT broker. Production: a private broker with credentials (see docs/OPERATIONS.md).
# Local development: ws://localhost:18884/mqtt from `npm run dev:cabinet`.
# NEVER the public broker locally: its topics drive the real cabinet.
HIVEMQ_BROKER_URL=ws://localhost:18884/mqtt
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=

# Email (Gmail SMTP is used first, then Resend)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Protects /api/cron/overdue (overdue reminder emails). Vercel Cron sends it
# automatically; an outside scheduler must send "Authorization: Bearer <value>".
#   openssl rand -hex 32
CRON_SECRET=

# Optional: only these email domains may sign up (comma-separated), e.g. uom.lk
SIGNUP_EMAIL_DOMAINS=
